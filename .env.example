# Local development only. Set production to AUTH_MODE=x and configure real X.
APP_URL=http://127.0.0.1:3000
BETTER_AUTH_URL=http://127.0.0.1:3000
AUTH_MODE=development
DATABASE_URL=postgresql://reddix@127.0.0.1:55432/reddix
# With compose.yaml use postgresql://reddix:local-reddix-only@127.0.0.1:55432/reddix
BETTER_AUTH_SECRET=
CRON_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Exact immutable X IDs, only used at first enrollment.
ADMIN_X_IDS=

# Optional @reddix moderation. Without a key, content stays visible and checks queue.
# Keep this server-only. See docs/MODERATION.md before enabling live inference.
OPENROUTER_API_KEY=
# auto: narrowly scoped automatic hides; review: admin decisions only; off: no inference.
REDDIX_MODERATION_MODE=auto
REDDIX_MODERATION_MODEL=mistralai/mistral-nemo
# UTC-day request reservations, including retries and work superseded after claiming.
REDDIX_MODERATION_DAILY_LIMIT=500
# USD per million tokens. These are provider price caps, not a dollar budget.
REDDIX_MODERATION_MAX_INPUT_USD_PER_MILLION=0.10
REDDIX_MODERATION_MAX_OUTPUT_USD_PER_MILLION=0.30

# Only for local development. Production migrations run explicitly.
AUTO_MIGRATE=1

# Production image uploads require private object storage.
# Use supabase for the native Storage API, s3 for an S3-compatible provider,
# or local for development disk storage. Blank preserves automatic S3/local choice.
STORAGE_PROVIDER=
STORAGE_BUCKET=
# Supabase: server-only project URL and sb_secret key. Never use NEXT_PUBLIC_ names.
# The bucket must already exist with public access disabled.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# S3 only. Supabase native Storage does not need these credentials.
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Reddix X growth bot. Leave off until the separate bot account exists.
# OAuth 2.0 confidential client; callback: /api/admin/x-bot/callback
# Connect the bot from Admin > Community growth after filling these values.
X_BOT_MODE=off
X_BOT_USER_ID=
X_BOT_CLIENT_ID=
X_BOT_CLIENT_SECRET=
# Set to 1 only after the X automation requirements in docs/X_GROWTH.md are met.
X_BOT_AUTOMATION_APPROVED=0
X_BOT_TIMEZONE=America/Los_Angeles
X_BOT_INCLUDE_SESSIONS=0
X_BOT_DAILY_POST_LIMIT=100
